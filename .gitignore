# Entorno del servidor (se instala con uv; ~560 MB)
.venv/

# Artefactos de compilación de Swift y paquete de distribución
MenuBarApp/.build/
MenuBarApp/dist/
# El icono se genera desde make-icon.swift en cada build (no versionamos binarios)
MenuBarApp/Resources/

# Estado de ejecución del servidor
*.log
.server.pid

# Resultados de benchmarks (locales, dependen de la máquina)
result_*.json

.DS_Store
